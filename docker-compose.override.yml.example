# Docker Compose Override Example
# Copy this file to docker-compose.override.yml to customize locally.
# Compose merges it on top of docker-compose.yml automatically.
#
# This only references services that actually exist in this stack:
#   ip2location-api, ip2location-updater, redis

services:
  ip2location-api:
    environment:
      - LOG_LEVEL=DEBUG
      # On tight memory with a large proxy CSV, keep a single in-memory copy:
      - WEB_CONCURRENCY=1
      - GUNICORN_THREADS=8
    # Expose the API directly (handy for local testing without a proxy in front).
    ports:
      - "8080:8080"

  ip2location-updater:
    environment:
      - LOG_LEVEL=DEBUG
      # Update more frequently while testing (e.g. every 6 hours):
      # - UPDATE_SCHEDULE=0 */6 * * *

  redis:
    # Expose Redis locally for inspection (redis-cli -p 6379).
    ports:
      - "6379:6379"
