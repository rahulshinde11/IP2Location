# API Configuration
API_KEY=your_secure_api_key
API_PORT=8080

# Authentication Configuration
DISABLE_API_KEY_AUTH=true

# IP2Location Configuration
# Required for downloading commercial databases. For LITE versions, leave empty.
IP2LOCATION_DOWNLOAD_TOKEN=
# Specify the database code (e.g., DB1LITE for free, DB26 for commercial)
IP2LOCATION_DATABASE_CODE=DB11LITEBINIPV6

# ASN Database Configuration
# Specify the ASN database code for autonomous system number lookups
IP2LOCATION_ASN_DATABASE_CODE=DBASNLITEBINIPV6

# Proxy Detection Configuration
# Enable proxy detection using CSV database (true/false)
ENABLE_PROXY_DETECTION=true
# Specify the proxy database code (e.g., PX1LITE for basic, PX12LITECSVIPV6 for full features)
PROXY_DATABASE_CODE=PX12LITECSVIPV6
# Proxy database file path (will be set automatically based on code)
PROXY_DATABASE_PATH=/app/db/IP2PROXY-LITE-PX12.IPV6.CSV

# Enhanced Proxy Detection with Nearby IP Analysis
# Enable nearby IP analysis for improved proxy detection (true/false)
ENABLE_NEARBY_PROXY_DETECTION=true
# Maximum distance to search for nearby IP ranges (higher = broader search)
NEARBY_IP_SEARCH_DISTANCE=1000
# Minimum number of nearby proxy ranges required to flag as probable proxy
NEARBY_IP_MIN_MATCHES=3

# Service Configuration
LOG_LEVEL=INFO
ENABLE_CLOUDFLARE_HEADERS=true
RATE_LIMIT_PER_MINUTE=100

# Updater Configuration
UPDATE_SCHEDULE=0 2 * * *
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7 